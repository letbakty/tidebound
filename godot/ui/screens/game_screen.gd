class_name GameScreen
extends ScreenBase
## Экран забега — пустышка: мир, HUD и панели живут на своих слоях, роутер
## только включает их видимость (docs/03 §1).
##
## ⚠️ Каркас ScreenBase (фон, поля, заголовок) здесь НЕ строится вовсе.
## Экран лежит на ScreenLayer — слое 40, самом верхнем, — и прозрачный
## полноэкранный каркас накрывал собой HUD (10), погоду (15), панели (20) и
## банеры (30): в забеге не нажималось ничего, кроме мира. Пустой экран не
## должен иметь ни узлов, ни прямоугольника.

func _ready() -> void:
	super()
	mouse_filter = Control.MOUSE_FILTER_IGNORE

## Каркаса нет: ни фона, ни заголовка, ни кнопки «назад».
func build_base() -> void:
	pass
