[input_devices]

; Жесты панорамы и пинча на Android приходят системой, а не эмулируются
; из касаний (research/20 §3): без этого пинч на телефоне не работает.
pointing/android/enable_pan_and_scale_gestures=true

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://assets/i18n/strings.en.translation", "res://assets/i18n/strings.ru.translation")

[physics]

; 60 и не менять: физику мы не используем, но на _physics_process висит
; аккумулятор сим-тика (research/11 §3), и снижение до 30 сделало бы грубее
; и ввод, и время симуляции.
common/physics_ticks_per_second=60
; Подкрутка дельты вредит и камере, и аккумулятору (research/10 §2).
common/physics_jitter_fix=0.0

common/physics_jitter_fix=0.0

[rendering]

; Пиксель-арт: сглаживание кромок ему противопоказано, а стоит оно кадра.
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/screen_space_aa=0
; Светов на экране ≤8 (docs/00 §16), 2048 избыточно; читается только на старте.
2d/shadow_atlas/size=1024
; Фон кадра = фон игры: иначе кадр начинается с лишней заливки другим цветом.
environment/defaults/default_clear_color=Color(0.039, 0.071, 0.086, 1)

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[shader_globals]

sim_time={
"type": "float",
"value": 0.0
}

[importer_defaults]

; Пиксель-арт: без сжатия, без мип-мапов, без «Detect 3D». Здесь, а не в
; каждом .import руками: иначе следующий добавленный PNG приедет с VRAM-сжатием
; и мылом, и заметят это через десять файлов (prompts/ART-integration §2 п.1).
texture={
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false
}
